# Get this from @BotFather on Telegram. Do not commit your real token.
TELEGRAM_BOT_TOKEN=

# OpenRouter key (starts with sk-or-). Keep it private.
OPENROUTER_API_KEY=
# Optional. Any OpenRouter model that supports structured outputs.
OPENROUTER_MODEL=google/gemini-3.6-flash

# Download the Desktop OAuth client JSON from Google Cloud and save it here.
GOOGLE_CREDENTIALS_FILE=data/google-credentials.json
GOOGLE_TOKEN_FILE=data/google-token.json
# Paste the full JSON from data/google-token.json. Required on Railway (the file is not deployed).
GOOGLE_TOKEN_JSON=
GOOGLE_CALENDAR_ID=primary
GOOGLE_EVENT_DURATION_MINUTES=30
